# Webroot hardening (Melde-parity)
RedirectMatch 403 /\.git
RedirectMatch 403 /scripts/

<FilesMatch "\.php~$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>

# Branded error pages
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php

# ARCHIV-35: CGI/FastCGI often strips Authorization — pass through for API Bearer auth
CGIPassAuth On
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
